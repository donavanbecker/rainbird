    "globals": "^15.8.0",
    "nodemon": "^3.1.4",
    "npm-check-updates": "^16.14.20",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.5",
    "typescript": "^5.5.4",
    "typescript-axios-wb": "^1.0.3",
    "typescript-eslint": "^8.0.0-alpha.47"
