    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.9.1",
    "eslint-plugin-format": "^0.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "npm-check-updates": "^17.1.0",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.6",
